# EditorConfig is awesome: https://EditorConfig.org

root = true

[*.md]
indent_style = space
indent_size = 2

[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,json,xml,props,targets}]
indent_style = space
indent_size = 2
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
